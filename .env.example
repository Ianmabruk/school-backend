# School Project Backend Environment Variables
# Copy to .env and configure for your deployment.

# Server
PORT=5000
NODE_ENV=production

# CORS — allow the school frontend origin
CLIENT_URL=https://school-frontend.vercel.app

# JWT secret for session tokens (use a strong random value in production)
JWT_SECRET=change-me-to-a-strong-random-secret

# SQLite database path (local file; no external DB required)
# DATA_DIR=./data
